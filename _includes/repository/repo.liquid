{% assign project = include.project %}
<article class="repo-card">
  <div class="repo-card-header">
    <h2 class="repo-card-title">{{ project.title }}</h2>
    {% if project.status %}<span class="repo-status">{{ project.status }}</span>{% endif %}
  </div>
  <p>{{ project.description }}</p>
  {% if project.role %}<p class="repo-role"><strong>Role:</strong> {{ project.role }}</p>{% endif %}
  {% if project.links %}
    <div class="repo-links" aria-label="Links for {{ project.title }}">
      {% for link in project.links %}
        <a class="btn btn-sm z-depth-0" href="{{ link.url }}">{{ link.label }}</a>
      {% endfor %}
    </div>
  {% endif %}
</article>
