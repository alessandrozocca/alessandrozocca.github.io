{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibsearch-form" role="search">
    <label for="bibsearch" class="bibsearch-label">Filter publications</label>
    <div class="bibsearch-controls">
      <input
        type="search"
        id="bibsearch"
        spellcheck="false"
        autocomplete="off"
        class="search bibsearch-form-input"
        placeholder="Search by title, author, venue, or year"
        aria-describedby="bibsearch-status"
      >
      <button type="button" id="bibsearch-clear" class="btn btn-sm z-depth-0" hidden>Clear</button>
    </div>
    <p id="bibsearch-status" class="sr-only" aria-live="polite"></p>
  </div>
{% endif %}
